class Solution {
public:
    struct Node {
        int prod;
        array<int, 5> cnt;

        Node() {
            prod = 1;
            cnt.fill(0);
        }
    };

    int k;
    int n;
    vector<Node> seg;

    Node mergeNode(const Node& A, const Node& B) {
        Node C;

        // Product of complete segment
        C.prod = (A.prod * B.prod) % k;

        // Prefixes completely inside A
        for (int r = 0; r < k; r++) {
            C.cnt[r] += A.cnt[r];
        }

        // Prefixes = complete A + prefix of B
        for (int r = 0; r < k; r++) {
            int newRem = (A.prod * r) % k;
            C.cnt[newRem] += B.cnt[r];
        }

        return C;
    }

    Node makeLeaf(int value) {
        Node res;

        int rem = value % k;

        res.prod = rem;
        res.cnt[rem] = 1;

        return res;
    }

    void update(int pos, int value) {
        pos += n;

        seg[pos] = makeLeaf(value);

        for (pos >>= 1; pos >= 1; pos >>= 1) {
            seg[pos] = mergeNode(seg[pos << 1],
                                  seg[pos << 1 | 1]);
        }
    }

    Node query(int l, int r) {
        // Query [l, r)
        Node leftRes;
        Node rightRes;

        l += n;
        r += n;

        while (l < r) {

            if (l & 1) {
                leftRes = mergeNode(leftRes, seg[l]);
                l++;
            }

            if (r & 1) {
                --r;
                rightRes = mergeNode(seg[r], rightRes);
            }

            l >>= 1;
            r >>= 1;
        }

        return mergeNode(leftRes, rightRes);
    }

    vector<int> resultArray(vector<int>& nums, int K,
                            vector<vector<int>>& queries) {

        n = nums.size();
        k = K;

        seg.resize(2 * n);

        // Build leaves
        for (int i = 0; i < n; i++) {
            seg[n + i] = makeLeaf(nums[i]);
        }

        // Build tree
        for (int i = n - 1; i >= 1; i--) {
            seg[i] = mergeNode(seg[i << 1],
                               seg[i << 1 | 1]);
        }

        vector<int> ans;
        ans.reserve(queries.size());

        for (auto& q : queries) {

            int index = q[0];
            int value = q[1];
            int start = q[2];
            int x = q[3];

            // Update persists for future queries
            update(index, value);

            // Prefixes of nums[start ... n-1]
            Node res = query(start, n);

            ans.push_back(res.cnt[x]);
        }

        return ans;
    }
};
