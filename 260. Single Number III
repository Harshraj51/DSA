class Solution {
public:
    vector<int> singleNumber(vector<int>& nums) {
         long long  XOR=0;
        for(auto num:nums){
            XOR ^=num;
        }
        long long bits = XOR & (-XOR);
        int x = 0, y = 0;
        for (int num : nums) {
            if (num & bits) {
                x ^= num;
            } else {
                y ^= num;
            }
        }
        
        return {x, y};
    }
};
