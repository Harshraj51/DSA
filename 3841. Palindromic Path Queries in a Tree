class Solution {
    vector<vector<int>> adj, up;
    vector<int> tin, tout, depth;
    vector<int> bit;
    int timer = 0, LOG;
    struct Fenwick {
        int n;
        vector<int> tree;

        Fenwick(int n) : n(n), tree(n + 2, 0) {}

        void add(int idx, int val) {
            while (idx <= n + 1) {
                tree[idx] ^= val;
                idx += idx & -idx;
            }
        }

        void rangeXor(int l, int r, int val) {
            add(l, val);
            add(r + 1, val);
        }

        int query(int idx) {
            int res = 0;
            while (idx > 0) {
                res ^= tree[idx];
                idx -= idx & -idx;
            }
            return res;
        }
    };

    int getBit(char c) {
        return 1 << (c - 'a');
    }

    int lca(int u, int v) {
        if (depth[u] < depth[v])
            swap(u, v);

        int diff = depth[u] - depth[v];

        for (int j = 0; j < LOG; j++) {
            if (diff & (1 << j))
                u = up[j][u];
        }

        if (u == v)
            return u;

        for (int j = LOG - 1; j >= 0; j--) {
            if (up[j][u] != up[j][v]) {
                u = up[j][u];
                v = up[j][v];
            }
        }

        return up[0][u];
    }

public:
    vector<bool> palindromePath(
        int n,
        vector<vector<int>>& edges,
        string s,
        vector<string>& queries
    ) {
        adj.assign(n, {});
        for (auto &e : edges) {
            adj[e[0]].push_back(e[1]);
            adj[e[1]].push_back(e[0]);
        }

        LOG = 1;
        while ((1 << LOG) <= n)
            LOG++;

        up.assign(LOG, vector<int>(n, 0));
        tin.assign(n, 0);
        tout.assign(n, 0);
        depth.assign(n, 0);

        vector<int> parent(n, -1);
        vector<int> order;
        order.reserve(n);

        vector<int> st = {0};
        parent[0] = 0;

        while (!st.empty()) {
            int u = st.back();
            st.pop_back();

            tin[u] = ++timer;
            order.push_back(u);

            for (int v : adj[u]) {
                if (v == parent[u])
                    continue;

                parent[v] = u;
                depth[v] = depth[u] + 1;
                st.push_back(v);
            }
        }

        vector<int> sz(n, 1);

        for (int i = n - 1; i >= 0; i--) {
            int u = order[i];

            if (u != 0)
                sz[parent[u]] += sz[u];
        }

        for (int u = 0; u < n; u++) {
            tout[u] = tin[u] + sz[u] - 1;
        }

        for (int u = 0; u < n; u++)
            up[0][u] = parent[u];

        for (int j = 1; j < LOG; j++) {
            for (int u = 0; u < n; u++) {
                up[j][u] = up[j - 1][up[j - 1][u]];
            }
        }

        Fenwick fw(n);

        for (int u = 0; u < n; u++) {
            fw.rangeXor(tin[u], tout[u], getBit(s[u]));
        }

        vector<bool> ans;

        for (string &q : queries) {
            string type;
            int u;
            stringstream ss(q);
            ss >> type >> u;

            if (type == "update") {
                char c;
                ss >> c;

                int delta = getBit(s[u]) ^ getBit(c);

                if (delta != 0) {
                    fw.rangeXor(tin[u], tout[u], delta);
                    s[u] = c;
                }
            } 
            else {
                int v;
                ss >> v;

                int w = lca(u, v);

                int mask = fw.query(tin[u])
                         ^ fw.query(tin[v])
                         ^ getBit(s[w]);

                ans.push_back(
                    (mask & (mask - 1)) == 0
                );
            }
        }

        return ans;
    }
};
