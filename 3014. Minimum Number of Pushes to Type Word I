class Solution {
public:
    int minimumPushes(string word) {
        int result = 0;
        unordered_map<int, int> mp;
        int i = 2;
        for(auto c: word){
           if(i>9){
            i=2;
           }
            mp[i]++;
            result += mp[i];
            i++;
        }
   return result;
    }
};
