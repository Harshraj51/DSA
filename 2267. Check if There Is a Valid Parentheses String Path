class Solution {
public:
    bool hasValidPath(vector<vector<char>>& grid) {
        int m = grid.size();
        int n = grid[0].size();

        if ((m + n - 1) % 2 != 0)
            return false;
        vector<vector<vector<bool>>> dp(
            m,
            vector<vector<bool>>(n, vector<bool>(m + n, false))
        );
        int startBalance = (grid[0][0] == '(' ? 1 : -1);
        if (startBalance < 0)
            return false;

        dp[0][0][startBalance] = true;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                if (i == 0 && j == 0)
                    continue;

                for (int bal = 0; bal <= m + n; bal++) {

                    if (grid[i][j] == '(') {

                
                        if (i > 0 && bal > 0 &&
                            dp[i - 1][j][bal - 1]) {
                            dp[i][j][bal] = true;
                        }

                        if (j > 0 && bal > 0 &&
                            dp[i][j - 1][bal - 1]) {
                            dp[i][j][bal] = true;
                        }

                    } else {

    
                        if (i > 0 &&
                            dp[i - 1][j][bal + 1]) {
                            dp[i][j][bal] = true;
                        }

                        if (j > 0 &&
                            dp[i][j - 1][bal + 1]) {
                            dp[i][j][bal] = true;
                        }
                    }
                }
            }
        }
        return dp[m - 1][n - 1][0];
    }
};
