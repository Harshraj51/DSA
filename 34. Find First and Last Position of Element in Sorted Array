class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int start = -1;
        int end = -1;

        // Find first occurrence
        int l = 0;
        int r = nums.size() - 1;

        while (l <= r) {
            int mid = l + (r - l) / 2;

            if (nums[mid] >= target) {
                if (nums[mid] == target)
                    start = mid;

                r = mid - 1;
            }
            else {
                l = mid + 1;
            }
        }

        // Find last occurrence
        l = 0;
        r = nums.size() - 1;

        while (l <= r) {
            int mid = l + (r - l) / 2;

            if (nums[mid] <= target) {
                if (nums[mid] == target)
                    end = mid;

                l = mid + 1;
            }
            else {
                r = mid - 1;
            }
        }

        return {start, end};
    }
};
