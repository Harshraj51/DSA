class Solution {
public:
    int missingInteger(vector<int>& nums) {
    int count = nums[0];
   
    int sum = 0;
    for(int i = 0; i<nums.size(); i++){
        if(nums[i]==count){
            sum += nums[i];
            count++;
        }
        else
            break;
    }
    while(find(nums.begin(), nums.end(), sum) != nums.end()){
        sum++;
    }
   return sum;
    }
};
