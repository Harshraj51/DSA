class Solution {
public:
    int uniquePaths(vector<vector<int>>& grid) {
        const long long MOD = 1e9 + 7;
        int m = grid.size(), n = grid[0].size();

        vector<vector<array<long long, 2>>> dp(
            m, vector<array<long long, 2>>(n, {0, 0})
        );

        for (int i = m - 1; i >= 0; --i) {
            for (int j = n - 1; j >= 0; --j) {

                if (i == m - 1 && j == n - 1) {
                    dp[i][j] = {1, 1};
                    continue;
                }

                if (grid[i][j] == 1) {
                    if (i + 1 < m)
                        dp[i][j][0] = dp[i + 1][j][1];

                    if (j + 1 < n)
                        dp[i][j][1] = dp[i][j + 1][0];
                } 
                else {
                    long long ways = 0;

                    if (j + 1 < n)
                        ways += dp[i][j + 1][0];

                    if (i + 1 < m)
                        ways += dp[i + 1][j][1];

                    ways %= MOD;

                    dp[i][j] = {ways, ways};
                }
            }
        }

        return (dp[0][1][0] + dp[1][0][1]) % MOD;
    }
};
