class Solution {
  public:
    int kthSmallest(vector<int> &arr, int k) {
        // code here
        priority_queue<int> pg;
        for(int i = 0; i<k; i++){
            pg.push(arr[i]);
        }
        
        for(int i = k; i<arr.size(); i++){
            if(pg.top() > arr[i]){
                pg.pop();
                pg.push(arr[i]);
            }
        }
        return pg.top();
    }
};
