// Solution 1
class Solution {
public:
    vector<int> targetIndices(vector<int>& nums, int target) {
        sort(nums.begin(),nums.end());
        vector<int> ans;
        for(int i = 0; i<nums.size(); i++){
            if(nums[i] == target){
                ans.push_back(i);
            }
        }
        return ans;
    }
};


//Solution 2
class Solution {
public:
    vector<int> targetIndices(vector<int>& nums, int target) {
        int count=0;
        for(int &num:nums){
            if(num < target)
                count++;
        }

        vector<int> result;
        for(int &num : nums){
            if(num == target){
                result.push_back(count);
                count++;
            }
        }
        return result;
    }
};
