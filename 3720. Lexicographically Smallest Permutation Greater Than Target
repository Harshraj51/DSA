class Solution {
public:
    string lexGreaterPermutation(string s, string target) {

        vector<int> freq(26, 0);

      
        for (char ch : s) {
            freq[ch - 'a']++;
        }

        string ans = "";

        for (int i = 0; i < target.size(); i++) {

            int t = target[i] - 'a';

          
            if (freq[t] > 0) {

                ans += target[i];
                freq[t]--;

            } 
            else {

                
                for (int c = t + 1; c < 26; c++) {

                    if (freq[c] > 0) {

                        ans += char('a' + c);
                        freq[c]--;

                      
                        for (int x = 0; x < 26; x++) {
                            while (freq[x] > 0) {
                                ans += char('a' + x);
                                freq[x]--;
                            }
                        }

                        return ans;
                    }
                }

               
                break;
            }
        }

       
        freq.assign(26, 0);

        for (char ch : s) {
            freq[ch - 'a']++;
        }

        
        int i = 0;

        while (i < target.size() && freq[target[i] - 'a'] > 0) {
            freq[target[i] - 'a']--;
            i++;
        }

       
        for (int j = i - 1; j >= 0; j--) {

           
            freq[target[j] - 'a']++;

            int t = target[j] - 'a';

           
            for (int c = t + 1; c < 26; c++) {

                if (freq[c] > 0) {

                    string result = target.substr(0, j);

                    result += char('a' + c);
                    freq[c]--;

                  
                    for (int x = 0; x < 26; x++) {
                        while (freq[x] > 0) {
                            result += char('a' + x);
                            freq[x]--;
                        }
                    }

                    return result;
                }
            }
        }

        return "";
    }
};
