class Solution {
public:
    bool checkDivisibility(int n) {
        int sum=0;
        int product = 1;
        int temp = n;
        while(temp){
            int rem = temp%10;
            sum+=rem;
            product = product * rem;
            temp=temp/10;
        }
        if(n % (product+sum) == 0)
            return true;
        return false;
    }
};
